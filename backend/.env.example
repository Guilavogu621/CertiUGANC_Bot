# ============================================================
# FICHIER D'EXEMPLE — NE PAS METTRE LES VRAIES VALEURS ICI
# Copiez ce fichier en `.env` et renseignez vos valeurs réelles.
# ============================================================

# Clé secrète Django (générer une nouvelle clé pour la prod)
SECRET_KEY=your-secret-key-here

# Mode débogage (True en dev, False en production)
DEBUG=True

# Hôtes autorisés (ex: monsite.com,www.monsite.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (laisser vide = utilise SQLite)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# Ex: DATABASE_URL=postgres://certiuganc_user:monmotdepasse@localhost:5432/certiuganc_db
